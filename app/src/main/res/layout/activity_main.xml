<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Sacude el teléfono dos veces para encender o apagar"
            android:textColor="#9AA4B2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTorch"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/btn_off"
            android:text="ENCENDER"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swEnabled"
            style="@style/Fila"
            android:text="Detector de sacudida activo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Más alta = se activa con sacudidas más suaves"
            android:textColor="#6B7685"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/swVibrate"
            style="@style/Fila"
            android:text="Vibrar al activar" />

        <Switch
            android:id="@+id/swAutoOff"
            style="@style/Fila"
            android:text="Apagar sola a los 10 minutos" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Permitir funcionar en segundo plano" />
    </LinearLayout>
</ScrollView>
